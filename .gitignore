# Dependencies (bun.lock is tracked deliberately — reproducible installs)
node_modules/
.bun/

# Database artifacts — the dataset is generated by datagenerator2 and read in place
# (MERCHANT_DB_PATH); any local copy stays out of the repo.
*.db
*.sqlite
*.sqlite3
*.db-wal
*.db-shm
data/
baskets.db*

# Build output — `bun run build` regenerates all of it
# CSS from src/styles/tailwind.entry.css; the Lit bundle from the installed package.
src/styles/tailwind.css
src/styles/tailwind.css.js
client/vendor/

# Logs
*.log

# Scratch / temp files
temp*.*
tmp*.*

# Local env overrides
.env
.env.local

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
