# Dependencies
node_modules/
.bun/
bun.lockb

# Database artifacts — the dataset is generated by datagenerator2 and read in place
# (MERCHANT_DB_PATH); any local copy stays out of the repo.
*.db
*.sqlite
*.sqlite3
*.db-wal
*.db-shm
data/

# Generated CSS — built from client/styles/tailwind.entry.css by `bun run css`
client/styles/tailwind.css.js
client/styles/tailwind.css

# Logs
*.log

# Scratch / temp files
temp*.*
tmp*.*

# Local env overrides
.env
.env.local

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
