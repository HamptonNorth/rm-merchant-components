# systemd unit for the rm-merchant-components harness on nuc2023.
#
# Runs as rcollins from /opt/rm-merchant-components, matching how aph2-website runs on the
# same box. Per-environment values (PORT, MERCHANT_DB_PATH) live in the EnvironmentFile,
# not here, so this file is identical wherever it is installed.
#
# Installed and refreshed by deploy/deploy.sh — you should not need to copy it by hand.

[Unit]
Description=rm-merchant-components development harness (Bun)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rcollins
Group=rcollins
WorkingDirectory=/opt/rm-merchant-components
EnvironmentFile=/etc/rm-merchant-components.env
ExecStart=/usr/local/bin/bun server/index.js
Restart=on-failure
RestartSec=2s
StartLimitIntervalSec=300
StartLimitBurst=5
StandardOutput=append:/var/log/rm-merchant-components/stdout.log
StandardError=append:/var/log/rm-merchant-components/stderr.log

# Hardening, with one deliberate hole.
#
# The app itself never writes: the dataset is opened `{ readonly: true }` and every route is
# a GET. That guard is enforced by SQLite on the connection, which is stronger than a
# filesystem permission — it holds however the directory is owned.
#
# The data directory is nonetheless writable, because the dataset stays in WAL journal mode
# and a WAL reader must create a `-shm` sidecar even on a readonly connection. WAL is kept
# on purpose: this is an internal box, and the dataset is expected to be edited with a SQLite
# console while the harness is serving. That is exactly the workload WAL is for — readers and
# writers do not block each other — and converting to journal_mode=delete to satisfy a
# read-only /opt would be undone by the first GUI tool that reopens the file in WAL.
#
# So /opt stays read-only for the code, and only data/ and the logs are writable.
#
# If a component ever gains a write path of its own (an order basket, a saved quote), it will
# fail here with a confusing "read-only file system", and the fix is to add that directory
# rather than to loosen the whole unit.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/rm-merchant-components/data /var/log/rm-merchant-components
PrivateTmp=true
PrivateDevices=true

[Install]
WantedBy=multi-user.target
